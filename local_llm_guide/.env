# ========================================
# 로컬 LLM 연결 설정 (IMPORTANT!)
# 이 파일은 절대 Git에 커밋하면 안 됩니다!
# .gitignore에 추가하세요.
# ========================================

# 사용하려는 백엔드 모델의 API 키나 토큰이 필요할 수 있습니다. 
# 만약 인증이 없다면 빈 문자열을 넣거나 주석 처리해도 무방합니다.
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxx" 

# 로컬 LLM 서버가 구동되는 엔드포인트 URL입니다. 
# (예: Ollama를 사용한다면 해당 포트를 지정)
LLM_BASE_URL="http://localhost:8000/v1"

# 사용할 모델 이름 (실제 백엔드가 지원하는 모델명으로 변경 필요)
DEFAULT_MODEL="llama2:7b"